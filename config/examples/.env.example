# Runtime
NODE_ENV=development

# API keys
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
LLM_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
GLADIA_API_KEY=your-gladia-api-key
OCR_SPACE_API_KEY=your-ocr-space-api-key
CLOUDFLARE_AI_API_KEY=your-cloudflare-ai-api-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
YANDEX_SPEECHKIT_API_KEY=your-yandex-speechkit-api-key

# LLM / provider
LLM_BASE_URL=https://api.deepseek.com
LLM_REPLY_MODEL=deepseek-flash
LOG_LLM_TEXT=false

# Config
TELEGRAM_CHAT_CONFIG_PATH=data/telegram-chat-config.json
TELEGRAM_ACCESS_CONFIG_PATH=data/telegram-access-config.json

# Storage
SQLITE_PATH=data/bot.sqlite
REDDIT_COOKIE_HEADER_PATH=data/reddit-cookie-header.txt
REDDIT_COOKIES_PATH=data/reddit-cookies.txt
INSTAGRAM_COOKIES_PATH=data/instagram-cookies.txt
YOUTUBE_COOKIES_PATH=data/youtube-cookies.txt

# Optional HTTP media workers (both or neither). Kubernetes/Compose set these.
# Without them, native/GitLab runs use locally installed CLI tools.
# MEDIA_VIDEO_URL=http://127.0.0.1:8081
# MEDIA_GALLERY_URL=http://127.0.0.1:8082
